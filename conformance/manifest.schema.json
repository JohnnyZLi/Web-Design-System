{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnnyli.dev/schemas/design-system-conformance-manifest.json",
  "title": "Johnny Li design-system consumer conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "rules"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "product": {"enum": ["portfolio", "network", "rolepacket"]},
    "outputDirectory": {"type": "string", "minLength": 1},
    "rules": {
      "type": "object",
      "propertyNames": {"pattern": "^DS-[A-Z0-9]+-[0-9]{3}$"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": {"enum": ["manual-passed", "manual-pending", "manual-failed"]},
              "reason": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence"],
            "properties": {
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/evidence"}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "file"],
      "properties": {
        "type": {"enum": ["file-exists", "contains", "not-contains", "matches", "json-equals", "json-matches"]},
        "file": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "value": {},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["string", "number", "boolean"]}
        },
        "pattern": {"type": "string"},
        "flags": {"type": "string", "pattern": "^[dgimsuvy]*$"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "contains"}}},
          "then": {"anyOf": [{"required": ["value"]}, {"required": ["values"]}]}
        },
        {
          "if": {"properties": {"type": {"const": "not-contains"}}},
          "then": {"anyOf": [{"required": ["value"]}, {"required": ["values"]}]}
        },
        {
          "if": {"properties": {"type": {"const": "matches"}}},
          "then": {"required": ["pattern"]}
        },
        {
          "if": {"properties": {"type": {"const": "json-equals"}}},
          "then": {"required": ["path", "value"]}
        },
        {
          "if": {"properties": {"type": {"const": "json-matches"}}},
          "then": {"required": ["path", "pattern"]}
        }
      ]
    }
  }
}
